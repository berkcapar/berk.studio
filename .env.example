# Contact form delivery (pages/api/contact.js).
# Without these the form still works - it falls back to a prefilled mailto.
#
# 1. Create a key at https://resend.com/api-keys
# 2. Verify a sending domain, then set CONTACT_FROM to an address on it.
# 3. Add both to Vercel: Project → Settings → Environment Variables.

RESEND_API_KEY=
CONTACT_FROM="berk.studio <hello@berk.studio>"

# Optional - defaults to berkcapar@gmail.com
# CONTACT_TO=
